{
  "name": "notion-backup",
  "version": "1.0.0",
  "description": "Export Notion pages and subpages to a GitHub repo on a schedule",
  "license": "MIT",
  "contributors": [
    "Richard Keil",
    "Karl Horky <karl.horky@gmail.com>"
  ],
  "type": "module",
  "main": "index.js",
  "dependencies": {
    "axios": "1.20.0",
    "extract-zip": "2.0.1",
    "p-map": "7.1.1"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "eslint-config-upleveled": "11.0.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  },
  "devEngines": {
